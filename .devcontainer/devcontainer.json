{
  "name": "Trivy Scanner",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/go:1": { "version": "1.26" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  // Rootless podman runs inside this container (the app starts Trivy with it), which needs
  // the container to be privileged. Podman's images live in a volume so rebuilds keep them.
  "privileged": true,
  "mounts": [
    "source=trivy-scanner-podman-storage,target=/home/vscode/.local/share/containers,type=volume"
  ],
  "containerEnv": {
    // Headless only: no GTK/WebKit in this container, so every go command builds server mode.
    "CGO_ENABLED": "0",
    "GOFLAGS": "-tags=server",
    "VET_TAGS": "server,production",
    "RACE": "",
    "WAILS_SERVER_PORT": "8080",
    "WAILS_VITE_PORT": "9245"
    // Alternative to nested podman: use the host's podman. Mount its socket via "mounts" and set
    // "CONTAINER_HOST": "unix:///run/podman/podman.sock". See docs/devcontainer.md.
  },
  // Installs the frontend deps, the Go reloader and the wails3 CLI (for `make bindings`).
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Trivy Scanner (make dev)", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "Vue.volar"],
      "settings": { "go.toolsEnvVars": { "CGO_ENABLED": "0", "GOFLAGS": "-tags=server" } }
    }
  }
}
