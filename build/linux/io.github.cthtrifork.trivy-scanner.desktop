[Desktop Entry]
Version=1.0
Type=Application
Name=Trivy Scanner
GenericName=Container Image Scanner
Comment=Scan container images with Trivy running in Podman
Exec=/usr/bin/trivy-scanner
Icon=trivy-scanner
Terminal=false
Categories=Security;System;Utility;
Keywords=trivy;vulnerability;cve;container;podman;sbom;security;
StartupNotify=true
# Matches the GTK application id the app sets (main.go), which is the Wayland app_id; the file name must be the same id.
StartupWMClass=io.github.cthtrifork.trivy-scanner
